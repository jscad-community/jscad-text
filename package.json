{
  "name": "jscad-text",
  "version": "4.0.0",
  "description": "JSCAD module to convert text to 2D paths, using TTF (and other) fonts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jscad-community/jscad-text.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "unpkg": "./dist/jscad-text.js",
  "jsdelivr": "./dist/jscad-text.js",
  "scripts": {
    "build": "rollup --config",
    "tests": "ava 'tests/*.test.js'",
    "coverage": "c8 --all --reporter=html --reporter=text npm run tests",
    "docs": "jsdoc2md --files 'src/*.js' > README.md"
  },
  "keywords": [
    "jscad",
    "text",
    "font",
    "ttf",
    "outline"
  ],
  "author": "z3dev",
  "license": "MIT",
  "dependencies": {
    "@jscad/modeling": "3.0.4-alpha.0",
    "opentype.js": "^1.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "ava": "^6.3.0",
    "c8": "^10.1.0",
    "jsdoc-to-markdown": "^9.1.3",
    "rollup": "^4.52.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
